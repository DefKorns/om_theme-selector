root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# shell scripts, command files and translations
[{mod/**,*.sh}]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab

# two trailing spaces are a line break
[*.md]
trim_trailing_whitespace = false
