# shellcheck source=/dev/null
source $mountpoint/etc/options_menu/themes/scripts/om_vars
script_init

"$om_scripts/gen_splash" /tmp/om_splash.png THEME_PREVIEW_LOADING && decodepng /tmp/om_splash.png >/dev/fb0
if [ ! -f "$b_file" ]; then
  sed '1,2d' $om_theme_script >"$b_file"
  echo "themeSelector" >"$p_file"
fi

# chmenu doesn't re-run preinit.d, so apply the DIY theme here
# shellcheck source=/dev/null
source "$b_file"
themeSelector

menuReloadLater
