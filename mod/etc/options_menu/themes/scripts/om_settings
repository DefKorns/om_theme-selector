# shellcheck source=/dev/null
source $mountpoint/etc/options_menu/themes/scripts/om_vars
script_init

# theme_manager's STATE_STR checks (om_state) would otherwise each re-derive
# $mod_state_path from scratch via om_functions/preinit - cache it once here so
# 5 toggle rows cost one lookup instead of five. Plain /tmp, no $mountpoint:
# this is throwaway same-boot-session IPC, not data that needs to live inside
# a particular mounted rootfs the way e.g. diy_theme_path does
echo "$mod_state_path" > /tmp/om_state_path

hasItemsToCleanUp "system_clean_up"
folderThemesRow

if [ -f "$b_file" ] && [ -f "$p_file" ]; then
  enableCmds "uninstaller"
  [ ! -f "$om_mod_settings_spacer" ] && touch "$om_mod_settings_spacer"
else
  disableCmds "uninstaller"
  [ ! -f "$enable_system_clean_up" ] && remove "$om_mod_settings_spacer"
fi

$options_menu/lib/theme_manager --commandPath $om_mod_settings_cmds/ --scriptPath $om_mod_settings_scripts --title THEME_SETTINGS --layout list &
