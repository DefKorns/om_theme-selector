musicHackBind() {
  { [ -f "$1" ] && [ -f "$2" ] && [ -f "$3/bgm_boot.wav" ] && [ -f "$3/bgm_home.wav" ]; } || return 1

  if [ "$sftype" = "nes" ]; then
    [ -f "$1" ] && mount_bind "$1" "$3/bgm_boot.wav" || return 1
  else
    [ -f "$SILENT_WAV" ] && mount_bind "$SILENT_WAV" "$3/bgm_boot.wav" || return 1
  fi

  [ -f "$2" ] && mount_bind "$2" "$3/bgm_home.wav" || return 1
  return 0
}

musicHackUnbind() {
  AUDIO_FILES_ARR="bgm_boot bgm_home se_sys_bounce se_sys_cancel se_sys_click se_sys_click_game se_sys_cursor se_sys_lock se_sys_ng se_sys_push se_sys_smoke se_sys_unlock"
  local CURRENT_MOUNTS
  CURRENT_MOUNTS="$(cat /proc/mounts)"

  for WAVE in $AUDIO_FILES_ARR; do
    case "$CURRENT_MOUNTS" in
    *" ${ORIGINAL_THEME_AUDIO}/${WAVE}.wav "*) umount "${ORIGINAL_THEME_AUDIO}/${WAVE}.wav" ;;
    esac
  done
}

fontBindFix() {
  [ ! -f "${FONT_PATH}/title.fnt.backup" ] && cp "${FONT_PATH}/title.fnt" "${FONT_PATH}/title.fnt.backup"
  for FONT in title s m l small medium large; do
    if [ "$1" == "backup" ] && [ -f "$FULL_THEME_PATH/fonts/${FONT}.fnt" ]; then
      cp "$FULL_THEME_PATH/fonts/${FONT}.fnt" "${FONT_PATH}/${FONT}.fnt"
    elif [ "$FONT" == "title" ]; then
      cp "${FONT_PATH}/title.fnt.backup" "${FONT_PATH}/title.fnt"
    else
      umount "${ORIGINAL_THEME}/resources/fonts/${UI1}/${FONT}.fnt" 2>/dev/null
      rm -f "${FONT_PATH}/${FONT}.fnt"
    fi
  done
}

# folder_themes lines: <folder key>=<theme dir>
assignedFolderTheme() {
  local LINE
  [ -n "$1" ] && [ -f "$STATE_PATH/folder_themes" ] || return 1
  while IFS= read -r LINE; do
    if [ "${LINE%=*}" = "$1" ] && [ -d "$THEMES_PATH/${LINE##*=}" ]; then
      echo "${LINE##*=}"
      return 0
    fi
  done <"$STATE_PATH/folder_themes"
  return 1
}

# the entry for folder $1 inside its parent folder (not a Back/Home shortcut to it)
folderEntry() {
  local DESKTOP
  for DESKTOP in "$GAME_STORAGE"/*/CLV-S-00"$1"/CLV-S-00"$1".desktop; do
    [ -f "$DESKTOP" ] || continue
    grep -q -e '^Name=Back$' -e '^Name=Home$' "$DESKTOP" && continue
    echo "$DESKTOP"
    return 0
  done
  return 1
}

# own assignment, else a theme named after the folder, else whatever its parent folder gets
folderTheme() {
  local CODE="$1"
  local DESKTOP
  local KEY
  local DEPTH=0
  if [ "$CODE" == "000" ]; then
    assignedFolderTheme "home"
    return
  fi
  while [ "$CODE" != "000" ] && [ "$DEPTH" -lt 16 ]; do
    DEPTH=$((DEPTH + 1))
    DESKTOP="$(folderEntry "$CODE")" || return 1
    KEY="$(sed -n 's/^Name=//p' "$DESKTOP" | head -n1 | sed 's/ /_/g' | awk '{print tolower($0)}')"
    assignedFolderTheme "$KEY" && return 0
    [ -n "$KEY" ] && [ -d "$THEMES_PATH/$KEY" ] && echo "$KEY" && return 0
    CODE="$(basename "$(dirname "$(dirname "$DESKTOP")")")"
  done
  return 1
}

themeSelector() {
  local FOLDER_ID
  local GAME_STORAGE
  local PREVIOUS_THEME
  local UI0="ui/$sftype-$sfregion"
  local UI1=""
  local SYSTEM_TYPE="$sftype"

  case "$sftype" in
  hvcj)
    UI0="ui/hvc"
    SYSTEM_TYPE="shonen"
    ;;
  nes)
    UI0="clover-ui"
    UI1="nes/"
    if [ "$sfregion" = "jpn" ]; then
      UI0="clover-ui"
      UI1="hvc"
      SYSTEM_TYPE="$UI1"
    fi
    ;;
  snes)
    [ "$sfregion" = "jpn" ] && UI0="ui/shvc"
    ;;
  esac
  local ORIGINAL_THEME="$mountpoint/usr/share/$UI0"
  local ORIGINAL_THEME_AUDIO="$ORIGINAL_THEME/resources/sounds/hvc"
  local THEMES_PATH="$mountpoint/media/$modname/themes/$SYSTEM_TYPE"
  [ ! -d "$THEMES_PATH" ] && THEMES_PATH="$rootfs/usr/share/themes/$SYSTEM_TYPE"
  local THEME_DIR_LIST
  THEME_DIR_LIST="$(find "$THEMES_PATH" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sed 's#^.*/##')"
  STATE_PATH="$mountpoint$profilepath/$modname"
  FOLDER_ID="$(cat "$STATE_PATH/menu")"
  local ACTIVE_FOLDER="CLV-S-00${FOLDER_ID}"
  local LAST_THEME="$STATE_PATH/lastTheme"
  local ACTIVE_THEME="$STATE_PATH/active_theme"
  [ -f "$LAST_THEME" ] && PREVIOUS_THEME=$(cat "$LAST_THEME")

  local SELECTED_THEME="CHANGEME"
  local DIY_THEME="$mountpoint/tmp/diy_theme"
  local FULL_THEME_PATH="$THEMES_PATH/$SELECTED_THEME"
  local FONT_PATH="$mountpoint/media/$modname/fonts"
  [ ! -d "$FONT_PATH" ] && FONT_PATH="$rootfs/usr/share/fonts"
  local TITLE_FONT="$FONT_PATH/title.fnt"
  local THEME_FONT_PATH="$FULL_THEME_PATH/fonts"

  SILENT_WAV="$rootfs/usr/share/themes/bgm_boot.wav"
  MUSIC_PATH="$mountpoint/media/$modname/music_menu"
  [ ! -d "$MUSIC_PATH" ] && MUSIC_PATH="$rootfs/usr/share/music_menu"
  BGM_HOME=""
  GAME_STORAGE="$(findGameStorage)"

  find "$GAME_STORAGE" -maxdepth 3 -type f -name "$ACTIVE_FOLDER.desktop" | sort -u | while IFS= read -r _; do
    if [ -f "$STATE_PATH/om_themerandomizer" ]; then
      SELECTED_THEME="$PREVIOUS_THEME"
      local n="0"
      while [ "$SELECTED_THEME" == "$PREVIOUS_THEME" ] && [ "$n" -lt 3 ]; do
        n=$((n + 1))
        SELECTED_THEME="$(printf '%s\n' "$THEME_DIR_LIST" | shuf | head -n1)"
      done
    fi

    [ "$FOLDER_ID" == "000" ] && [ -d "$THEMES_PATH/default" ] && SELECTED_THEME="default"
    if [ -f "$STATE_PATH/om_themeperfolder" ]; then
      local FOLDER_THEME
      FOLDER_THEME="$(folderTheme "$FOLDER_ID")"
      [ -n "$FOLDER_THEME" ] && SELECTED_THEME="$FOLDER_THEME"
    fi

    FULL_THEME_PATH="$THEMES_PATH/$SELECTED_THEME"

    if find "$DIY_THEME" -type f 2>/dev/null | read -r _; then
      FULL_THEME_PATH="$DIY_THEME"
    fi

    if [ "$SELECTED_THEME" != "$PREVIOUS_THEME" ] || [ ! -f "$LAST_THEME" ] || [ ! -f "$ACTIVE_THEME" ]; then
      echo "$SELECTED_THEME" >"$LAST_THEME"
      echo "$FULL_THEME_PATH" >"$ACTIVE_THEME"
    fi

    if [ -d "$THEME_FONT_PATH" ]; then
      cmp -s "$TITLE_FONT" "$THEME_FONT_PATH/title.fnt" || fontBindFix "backup"
    else
      fontBindFix "restore"
    fi

    # lazy, since fontFix binds title.font on top of the overlay after every chmenu
    while grep -q " $ORIGINAL_THEME overlayfs " /proc/mounts; do
      umount -l "$ORIGINAL_THEME" || break
    done
    musicHackUnbind

    cd "$THEMES_PATH/$PREVIOUS_THEME" && find ./* -type f ! -name "*.wav" ! -path "./fonts/*" | cut -c3- | while IFS= read -r UMOUNT_FILE; do
      umount "$ORIGINAL_THEME/$UMOUNT_FILE"
    done

    if [ "$FULL_THEME_PATH" != "$DIY_THEME" ] && [ -f "$FULL_THEME_PATH/needs_overlay" ]; then
      [ -d "$FULL_THEME_PATH" ] && mount -t overlayfs -o lowerdir="$ORIGINAL_THEME",upperdir="$FULL_THEME_PATH" overlayfs "$ORIGINAL_THEME"
    else
      if [ -f "$STATE_PATH/om_audiorandomizer" ] && [ -n "$(ls -A "$MUSIC_PATH")" ]; then
        [ -z "$BGM_HOME" ] && BGM_HOME="$(find "$MUSIC_PATH" -maxdepth 1 -type f -iname "*.wav" | shuf | head -n1)"
        if [ "$FOLDER_ID" = "000" ]; then
          musicHackBind "$BGM_HOME" "$BGM_HOME" "$ORIGINAL_THEME_AUDIO"
        else
          [ -f "$STATE_PATH/om_advmusichack" ] && [ -z "$(find "$FULL_THEME_PATH" -type f -name "*.wav")" ] && musicHackBind "$BGM_HOME" "$BGM_HOME" "$ORIGINAL_THEME_AUDIO"
        fi
      fi

      cd "$FULL_THEME_PATH" && find . -type f ! -path "./fonts/*" | while IFS= read -r THEME_FILE; do
        mount_bind "$FULL_THEME_PATH/$THEME_FILE" "$ORIGINAL_THEME/$THEME_FILE"
      done
    fi

    cd - >/dev/null || exit
    break
  done

}
