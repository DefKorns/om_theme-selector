om_mod_path="$nand_path/$modtitle"
nand_theme_path="$nand_path/$modtitle/$s_type"
theme_path="$usb_path/$modtitle/$s_type"
if [ -d "$usb_path" ]; then
  mkdir -p "$theme_path"
else
  theme_path="$nand_theme_path"
fi
hasMusicFiles() {
  find "$1" -maxdepth 1 -type f -iname "*.wav" 2>/dev/null | read -r _
}
music_path="$usb_path/music_menu"
hasMusicFiles "$music_path" || music_path="$nand_path/music_menu"
nes_theme_path="${om_mod_path}/nes"
shonen_theme_path="${om_mod_path}/shonen"
snes_theme_path="${om_mod_path}/snes"

#### ARRAYS
diy_asset_array="diy_packed diy_wall diy_wall_far diy_wall_near diy_mario diy_luigi diy_colors diy_pole" # verify
del_shared="$nes_theme_path $disable_smb $disable_packed_nes $disable_colors_nes $om_mod_packed_nes $om_mod_sbm $om_mod_colors_nes ${om_mod_imgs}/smb.png ${om_mod_imgs}/packed_nes.png $disable_color $om_mod_colors"

del_on_nes="$snes_theme_path $shonen_theme_path $disable_color $disable_pole $disable_mario $disable_luigi $disable_packed $disable_wall $disable_wall_far $disable_wall_near $om_mod_pole $om_mod_mario $om_mod_luigi $om_mod_wall $om_mod_wall_n $om_mod_wall_f $om_mod_packed $om_mod_colors ${om_mod_imgs}/luigi.png ${om_mod_imgs}/mario.png ${om_mod_imgs}/packed.png ${om_mod_imgs}/pole.png ${om_mod_imgs}/wall*.png"
del_on_snes="$shonen_theme_path $del_shared"
del_on_shonen="$snes_theme_path $del_shared"
items_to_delete="$del_on_snes"

# shellcheck disable=SC2012
has_theme="$(ls -1 "$theme_path/$system_name".*.tar.gz 2> /dev/null | wc -l)"

################
original_theme_ui0="ui/$sftype-$sfregion"
case "$sftype" in
  hvcj)
    items_to_delete="$del_on_shonen"
    original_theme_ui0="ui/hvc"
    ;;
  nes)
    items_to_delete="$del_on_nes"
    original_theme_ui0="clover-ui"
    ;;
  snes)
    [ "$sfregion" = "jpn" ] && original_theme_ui0="ui/shvc"
    ;;
esac
original_theme_path="$mountpoint/usr/share/$original_theme_ui0"

themeIsBindable() {
  find "$1" -type f ! -path "$1/fonts/*" ! -path "$1/info" ! -path "$1/dependencies.json" \
    ! -path "$1/resources/scripts/env/env_*.lua" | while IFS= read -r f; do
    [ -f "$original_theme_path/${f#"$1"/}" ] || exit 1
  done
}


migrateThemes() {
  [ "$theme_path" = "$nand_theme_path" ] && return 1
  [ -n "$(ls -A "$nand_theme_path" 2> /dev/null)" ] || return 1
  for item in "$nand_theme_path"/*; do
    name="${item##*/}"
    if [ "$name" != "$sfregion" ] && [ ! -e "$theme_path/$name" ]; then
      "$om_scripts/gen_splash" /tmp/om_splash.png THEME_MOVING_LINE1 THEME_MOVING_LINE2 && decodepng /tmp/om_splash.png > /dev/fb0
      break
    fi
  done
  for item in "$nand_theme_path"/*; do
    dest="$theme_path/${item##*/}"
    rm -rf "$dest"
    if cp -a "$item" "$dest"; then
      rm -rf "$item"
    else
      rm -rf "$dest"
    fi
  done
  [ -f "$thm_chk" ] && sed -i "s#^$nand_theme_path/#$theme_path/#" "$thm_chk"
  return 0
}

hasThemesToInstall() {
  [ "$has_theme" = 0 ] && return
  for f in "$theme_path/$system_name".*.tar.gz; do
    [ -f "$f" ] || continue
    tar -xzf "$f" -C "$theme_path" && rm -f "$f"
  done
}

clearList() {
  find "$om_mod_commands" "$om_mod_scripts" -type f \
    -not -name 'om_*' -not -name 'c0000_*' \
    -not -name 'c999[0-9]_*' -not -name '_*' -exec rm {} +
  remove "$om_mod_spacer"
}

clearDownloads() {
  find "$om_mod_sub_cmds" "$om_mod_sub_scripts" "$om_mod_sub" -type f \
    -not -name 'c000[0-8]_*' -not -name 'c999[0-9]_*' \
    -not -name 'om_*' -not -name '_*' -not -path "$thm_preview/*" -exec rm {} +
}

enableMenuOptions() {
  enableCmds "theme_generator" "clear"
  disableCmds "settings" "color"

  if [ ! -f "$om_dummy" ]; then
    disableCmds "clear"
  fi

  toggleDownloads

  [ -z "$(ls -A "$theme_path")" ] && disableCmds "theme_generator"

  if [ -f "$b_file" ] || [ -f "$p_file" ]; then
    enableCmds "settings"
  fi

 enableCmds "audio_setting" "advanced_music_hack"
  [ -f "$(cat "$thm_chk" 2> /dev/null)/needs_overlay" ] && disableCmds "audio_setting" "advanced_music_hack"

  if [ "$sftype" = "nes" ]; then
    sprite_src="hvc"
    sprite_dest="nes"

    if [ "$sfregion" = "jpn" ]; then
      sprite_src="nes"
      sprite_dest="hvc"
    fi

    for subdir in "${om_mod_packed_nes}/assets"/*; do
      rename "${subdir}/${sprite_src}.png" "${subdir}/${sprite_dest}.png"
    done
  fi
  [ ! -d "$has_folders" ] && disableCmds "theme_generator"
}

# avoids re-running the full themeLoader scan (~1.7s) when nothing changed
themeCountChanged() {
  new_count="$(find "$theme_path" -mindepth 1 -maxdepth 1 -type d | wc -l)"
  old_count="$(cat "$om_theme_count" 2> /dev/null)"
  echo "$new_count" > "$om_theme_count"
  [ "$new_count" != "$old_count" ]
}

themeLoader() {
  removeRegionalTheme
  cd "$theme_path" && find . -mindepth 1 -maxdepth 1 -type d | sed 's#^\./##' | sort -u | while IFS= read -r thm; do
    full_path="$theme_path/$thm"
    resource_path="$full_path/resources"
    sprite_path="$resource_path/sprites"
    script_path="$resource_path/scripts"
    cmd_list="$om_mod_commands/c0001_$thm"
    thm_script="$om_mod_scripts/$thm"
    tmp_thm_script="$om_theme_script"

    if [ ! -f "$full_path/info" ]; then
      thm_title="$(echo "$thm" | sed -e 's/_/ /g' | awk '{for(i=1;i<=NF;i++){$i=toupper(substr($i,1,1))substr($i,2)}}1')"
      size="$(du -sh "$full_path" | cut -f1)"
      echo "NAME=$thm_title [${size}b]" > "$full_path/info"
    fi

    if [ ! -f "$full_path/needs_overlay" ] && [ ! -f "$full_path/bind_ok" ]; then
      if themeIsBindable "$full_path"; then
        touch "$full_path/bind_ok"
      else
        touch "$full_path/needs_overlay"
      fi
    fi

    if [ ! -s "$full_path.png" ]; then
      if [ -d "$usb_path" ]; then
        copier "$thm_preview/$thm.png" "$full_path.png"
      else
        link "$thm_preview/$thm.png" "$full_path.png"
      fi
    fi

    create "$om_mod_spacer"

    if [ "$sftype" = "nes" ]; then
      sprite_src="hvc"
      sprite_dest="nes"

      if [ "$sfregion" = "jpn" ]; then
        sprite_src="nes"
        sprite_dest="hvc"
      fi

      for ext in "png" "json"; do
        rename "${sprite_path}/${sprite_src}.${ext}" "${sprite_path}/${sprite_dest}.${ext}"
      done
      rename "${script_path}/colors_${sprite_src}.lua" "${script_path}/colors_${sprite_dest}.lua"
    fi

    copy "$om_mod_license" "$thm_script.sh"

    if [ ! -d "$has_folders" ]; then
      tmp_thm_script="$om_overlay_theme_script"
    fi

    echo "sed '1,2d' \"$tmp_thm_script\" >\"$b_file\"
  [ ! -f \"$p_file\" ] && echo themeSelector >\"$p_file\"
sed -i \"s/selected_theme=\\\"CHANGEME\\\"/selected_theme=\\\"${thm}\\\"/g;\" \"$b_file\"
" >> "$thm_script.sh"

    echo "\"\$om_scripts/gen_splash\" /tmp/om_splash.png THEME_APPLYING_LINE1 THEME_APPLYING_LINE2 && decodepng /tmp/om_splash.png > /dev/fb0
sleep 1
    hakchi reboot" >> "$thm_script.sh"

    preview_image="$thm_preview/$thm.png"
    [ ! -f "$preview_image" ] && preview_image="$theme_path/$thm.png"
    [ ! -f "$preview_image" ] && [ -z "${thm##diy_theme*}" ] && preview_image="$options_menu/images/diy_preview.png"
    [ ! -f "$preview_image" ] && preview_image="$options_menu/images/default_preview.png"

    cmd_name="$(sed -r 's/NAME=//g' < "$full_path/info")"
    echo "COMMAND_NAME=$cmd_name
COMMAND_TYPE=EXTERNAL
COMMAND_STR=sh $thm_script.sh
PREVIEW_IMAGE=$preview_image
DELETE_STR=rm -rf \"$full_path\" \"$full_path.png\" \"$cmd_list\" \"$thm_script.sh\" && usleep 50000 && %options_path%lib/theme_manager --title INSTALLED_THEMES &" > "$cmd_list"
  done
}

removeRegionalTheme() {
  [ "$(globalTheme)" = "$sfregion" ] && return
  remove "$theme_path/$sfregion" "$theme_path/$sfregion.png" \
    "$om_mod_commands/c0001_$sfregion" "$om_mod_scripts/$sfregion.sh"
}

getThemeList() {
  "$om_scripts/gen_splash" /tmp/om_splash.png THEME_LIST_DOWNLOADING_LINE1 THEME_LIST_DOWNLOADING_LINE2 && decodepng /tmp/om_splash.png > /dev/fb0
  cd "$om_mod_sub" || exit

  if [ ! -e "${s_type}${list_name}" ]; then
    clearDownloads
    theme_downloader catalog "$s_type" "${s_type}${list_name}"
    case "$?" in
      0) ;;
      3) translate NOT_ENOUGH_SPACE ;;
      *) netChecker ;;
    esac
  fi
  # shellcheck disable=SC2035
  tar -xzf "${s_type}${list_name}" && rm -f *.tar.gz
  removeRegionalTheme
  touch "$sub_dummy"
  usleep 1000
}

injectFile() {
  # shellcheck disable=SC2068
  for scrpt in $@; do
    case "$scrpt" in
      chmenu)
        injected_file="$chmenu_file"
        ;;
      fontfix)
        injected_file="$fontfix_file"
        ;;
    esac

    if ! grep -q "# themeselector" "$injected_file"; then
      if [ "$scrpt" = "chmenu" ]; then
        # shellcheck disable=SC1004
        sed -i '/^overmount_games.*/a  # themeselector fix \
themeSelector \
fontFix' "/var/lib/hakchi/rootfs/bin/chmenu"
      fi

      if [ "$scrpt" = "fontfix" ]; then
        # shellcheck disable=SC1004,SC2016
        sed -i '/^fontFix_getPath().*/a  # themeselector \
  if [ -f "$mountpoint$profilepath/$modname/active_theme" ]; then \
    active_theme=$(cat "$mountpoint$profilepath/$modname/active_theme") \
    fontFix_getPath0 "$active_theme/fonts/$1" && return 0 \
  fi' "$mountpoint/etc/preinit.d/b8025_fontfix"
      fi
    fi
  done
}

loadThemeList() {
  if [ -n "$(ls -A "$theme_path")" ]; then
    create "$om_dummy"
    if [ "$1" = "-r" ]; then
      themeLoader
    fi
  else
    remove "$om_mod_spacer"
    clearList
  fi
}

themeGenerator() {
  echo "Packaging: DefKorns"
  translate CATEGORY_UI_MOD
  echo ""
  translate CHECKING_THEME_FILES
  echo ""
  theme_name="${1}"
  full_title="$(grep -F 'NAME=' "${om_mod_sub_cmds}/c0010_${theme_name}" | sed -e 's/.*=\(.*\)\[.*/\1/')"
  full_path="${theme_path}/${theme_name}"
  cd "${theme_path}" || exit
  translate DOWNLOADING

  if [ "${theme_name}" = "all" ]; then
    theme_downloader all-manifest "$sftype" "${sftype}-all"
    rc=$?
    failed=""
    if [ "$rc" = 0 ]; then
      downloadThemes "${sftype}-all"
      rc=$?
    fi
    remove "${sftype}-all"
  else
    downloadTheme "$theme_name"
    rc=$?
    if [ "$rc" = 0 ]; then
      size="$(du -sh "${full_path}" | cut -f1)"
      echo "NAME=${full_title}[${size}b]" > "${full_path}/info"
    fi
  fi

  removeRegionalTheme
  echo ""
  case "$rc" in
    0) translate INSTALLATION_COMPLETE ;;
    3) translate NOT_ENOUGH_SPACE ;;
    4) translate ALL_THEMES_INSTALLED ;;
    *) netChecker ;;
  esac
  if [ -n "$failed" ]; then
    echo ""
    translate THEMES_FAILED
    echo "$failed"
  fi
}

freeSpaceKb() {
  df -Pk "$1" | awk 'NR==2 {print $4}'
}

unpackedSizeKb() {
  size_kb=$(( $(tail -c4 "$1" | od -An -tu4) / 1024 + 1 ))
  echo $(( size_kb + size_kb / 10 ))
}

downloadTheme() {
  theme_downloader theme "$sftype" "$1" "${system_name}.$1.tar.gz" || return
  unpackTheme "$1"
}

downloadThemes() {
  pending="/tmp/${sftype}-pending"
  progress="/tmp/${sftype}-progress"
  while IFS= read -r t; do
    [ -d "$t" ] || [ "$t" = "$sfregion" ] || echo "$t"
  done < "$1" > "$pending"
  if [ ! -s "$pending" ]; then
    remove "$pending"
    return 4
  fi
  remove "$progress"
  mkfifo "$progress"
  theme_downloader themes "$sftype" "$pending" > "$progress" &
  dl_pid=$!
  dl_all_rc=0
  while read -r t_rc t; do
    echo "$t"
    echo ""
    if [ "$t_rc" = 0 ]; then
      unpackTheme "$t"
      t_rc=$?
    fi
    case "$t_rc" in
      0) ;;
      3) dl_all_rc=3 && break ;;
      *) failed="$failed $t" ;;
    esac
  done < "$progress"
  kill "$dl_pid" 2> /dev/null
  wait "$dl_pid"
  [ "$?" = 3 ] && dl_all_rc=3
  rm -f "$pending" "$progress" "$system_name".*.tar.gz "$system_name".*.tar.gz.part
  return "$dl_all_rc"
}

unpackTheme() {
  tarball="${system_name}.$1.tar.gz"
  if [ "$(freeSpaceKb .)" -lt "$(unpackedSizeKb "$tarball")" ]; then
    dl_rc=3
    gzip -t "$tarball" 2> /dev/null || dl_rc=1
  elif ! tar -xzf "$tarball"; then
    dl_rc=1
    [ "$(freeSpaceKb .)" -lt 1024 ] && dl_rc=3
  else
    remove "$tarball"
    return 0
  fi
  rm -rf "$tarball" "$1" "$1.png"
  return "$dl_rc"
}

findDiyAsset() {
  "$om_scripts/gen_splash" /tmp/om_splash.png THEME_LOADING && decodepng /tmp/om_splash.png > /dev/fb0

  diy_file="${1}.png"
  diy_sprite="$om_mod_sprites/${1}"
  asset_path="layout/asset/sprite/wallpaper"
  asset="$diy_file"
  chars="0"
  colors="0"
  preview_square="0"
  preview_cols=""
  json=""

  case "$1" in
    luigi | mario)
      diy_file="${1}_run01.png"
      asset_path="layout/asset/sprite/${1}"
      asset="*.*"
      chars="1"
      preview_square="1"
      preview_cols="5"
      ;;
    wall)
      preview_square="1"
      preview_cols="5"
      ;;
    wall_near | wall_far)
      preview_square="1"
      ;;
    sbm)
      diy_file="characters_sbm.png"
      asset_path="sprites"
      asset="characters_sbm.png"
      chars="1"
      ;;
    packed)
      asset_path="sprites"
      preview_square="1"
      preview_cols="4" # full UI screenshots - too detailed to shrink to 7 cols
      ;;
    packed_nes)
      diy_file="${sftype}.png"
      [ "$sfregion" = "jpn" ] && diy_file="hvc.png"
      asset_path="sprites"
      asset="$diy_file"
      preview_square="1"
      preview_cols="4" # full UI screenshots - too detailed to shrink to 7 cols
      ;;
    colors)
      asset_path="scripts/env"
      diy_file="$1_$sfregion.lua"
      asset="$diy_file"
      colors="1"
      ;;
    colors_nes)
      asset_path="scripts"
      diy_file="${1}.lua"
      [ "$sfregion" = "jpn" ] && diy_file="colors_hvc.lua"
      asset="$diy_file"
      colors="1"
      ;;
    pole)
      diy_file="${1}01.png"
      asset="*.*"
      chars="1"
      preview_square="1"
      ;;
  esac

  diy_crop_x=""
  diy_sprites_json="$om_mod_scripts/om_${1}.sprites.json"
  if [ "$colors" = "0" ] && [ -f "$diy_sprites_json" ]; then
    diy_frame="$(grep -o '"textureFrame":\[[0-9]*,[0-9]*,[0-9]*,[0-9]*\]' "$diy_sprites_json" | grep -o '[0-9]*,[0-9]*,[0-9]*,[0-9]*')"
    diy_crop_x="${diy_frame%%,*}"
    diy_rest="${diy_frame#*,}"
    diy_crop_y="${diy_rest%%,*}"
    diy_rest="${diy_rest#*,}"
    diy_crop_w="${diy_rest%%,*}"
    diy_crop_h="${diy_rest#*,}"
  fi
  paths_to_search="$om_mod_sprites/assets/$1 $theme_path"

  find "$diy_sprite/commands" "$diy_sprite/scripts" -type f \
    -not -name 'om_*' -not -name 'c999[0-9]_*' -not -name 'c0000_*' \
    -not -name 'c0001_*' -not -name '_*' -exec rm {} +

  # read once - avoids a [ -f ] stat() per theme below, slow on USB/SD
  existing_cmds="$(ls -1 "$diy_sprite/commands" 2>/dev/null)"
  existing_scripts="$(ls -1 "$diy_sprite/scripts" 2>/dev/null)"

  diy_crop_batch=0
  diy_seen_hashes="" # collapses themes that reuse a byte-identical source asset under a different name
  for p in $paths_to_search; do
    if [ "$(ls -A "$p")" ]; then
      # shellcheck disable=SC2038
      # a temp file, not a pipe into the while loop: a pipe would put the backgrounded crops in a subshell the wait below can't catch
      cd "$p" && find . -mindepth 1 -maxdepth 1 -type d | xargs -n 1 basename | sort -u > /tmp/diy_asset_list
      while IFS= read -r asset_name; do

        has_sprite="0"
        full_asset_path="$p/$asset_name"
        json="${om_mod_sprites}/${1}_${asset_name}.json"
        resource_path="$full_asset_path/resources"

        [ -f "$full_asset_path/$diy_file" ] && has_sprite="1"
        [ -f "$resource_path/$asset_path/$diy_file" ] && has_sprite="1"

        if [ $has_sprite = "1" ] && [ "$asset_name" = "${asset_name#diy_theme}" ]; then
          cmd_file="$diy_sprite/commands/c0001_$asset_name"
          sprite_script="$diy_sprite/scripts/$asset_name"
          info_path="$full_asset_path" # theme root, before the next line repoints full_asset_path

          [ "$p" = "$theme_path" ] && full_asset_path="$resource_path/$asset_path"

          preview_image="$full_asset_path/$diy_file"

          # hashed pre-crop, so this doesn't have to wait on the backgrounded crop job below
          if [ -f "$preview_image" ]; then
            sprite_hash="$(md5sum "$preview_image" | cut -d' ' -f1)"
            if printf '%s\n' "$diy_seen_hashes" | grep -qxF "$sprite_hash"; then
              rm -f "$cmd_file" "$sprite_script.sh"
              continue
            fi
            diy_seen_hashes="$diy_seen_hashes
$sprite_hash"
          fi

          temp_preview="${om_mod_sprites}/assets/${1}/${1}_${asset_name}.png"

          if [ "$colors" = "1" ]; then
            preview_image="$temp_preview"
          fi
          [ "$chars" = "1" ] && temp_preview="$preview_image"
          if [ "$colors" = "0" ] && [ "$chars" != "1" ] && [ -n "$diy_crop_x" ]; then
            if [ ! -f "$temp_preview" ]; then
              # backgrounded, batched 4 at a time (this console's core count)
              sprite_crop "$preview_image" "$diy_crop_x" "$diy_crop_y" "$diy_crop_w" "$diy_crop_h" "$temp_preview" &
              diy_crop_batch=$((diy_crop_batch + 1))
              if [ "$diy_crop_batch" -ge 4 ]; then
                wait
                diy_crop_batch=0
              fi
              usleep 1000
            fi
            preview_image="$temp_preview" # cropped copy, queued above or already cached
          fi

          if ! printf '%s\n' "$existing_cmds" | grep -qxF "c0001_$asset_name" || ! printf '%s\n' "$existing_scripts" | grep -qxF "$asset_name.sh"; then
            touch "$cmd_file"
            cmd_name="$(echo "$asset_name" | sed -e 's/_/ /g' | awk '{for(i=1;i<=NF;i++){$i=toupper(substr($i,1,1))substr($i,2)}}1')"
            [ "$p" = "$theme_path" ] && cmd_name="$(sed -r 's/NAME=//g' < "$info_path/info" | awk '{$NF="";sub(/[ \t]+$/,"")}1')"

            # chars=1: tiny sprites blown up a lot, nearest keeps them crisp
            preview_nearest=""
            [ "$chars" = "1" ] && preview_nearest="
PREVIEW_NEAREST=TRUE"
            preview_square_str=""
            [ "$preview_square" = "1" ] && preview_square_str="
PREVIEW_SQUARE=TRUE"
            preview_cols_str=""
            [ -n "$preview_cols" ] && preview_cols_str="
PREVIEW_GRID_COLS=$preview_cols"
            preview_fit_str=""
            [ "$chars" = "1" ] && preview_fit_str="
PREVIEW_FIT_CONTAIN=TRUE
PREVIEW_HIDE_LABEL=TRUE"
            echo "COMMAND_NAME=$cmd_name
COMMAND_TYPE=INTERNAL
COMMAND_STR=sh $sprite_script.sh
PREVIEW_IMAGE=$preview_image${preview_nearest}${preview_square_str}${preview_cols_str}${preview_fit_str}" > "$cmd_file"

            copy "$om_mod_license" "$sprite_script.sh"
            echo "diySpriteSelector \"$full_asset_path\" \"$asset_path\" \"$asset\"" >> "$sprite_script.sh"
          fi
        fi
      done < /tmp/diy_asset_list
      remove /tmp/diy_asset_list
    fi
  done
  wait # catch whatever's left of the last batch before returning
}

diySpriteSelector() {
  diy_selected_asset="$1"
  diy_layout="$diy_resources/$2"
  diy_asset="$diy_layout"

  [ ! -d "$diy_asset" ] && mkdir -p "$diy_asset"
  find "$diy_selected_asset" -name "$3" -exec cp {} "$diy_layout" \;
  if [ ! -f "$b_file" ]; then
    sed '1,2d' "$om_theme_script" > "$b_file"
    echo themeSelector > "$p_file"
  fi
  echo ""
  echo "  ____ _____   __  _____ _   _ _____ __  __ _____    ____ ____  _____    _  _____ ___  ____  "
  echo " |  _ \\_ _\\ \\ / / |_   _| | | | ____|  \\/  | ____|  / ___|  _ \\| ____|  / \\|_   _/ _ \\|  _ \\ "
  echo " | | | | | \\ V /    | | | |_| |  _| | |\\/| |  _|   | |   | |_) |  _|   / _ \\ | || | | | |_) |"
  echo " | |_| | |  | |     | | |  _  | |___| |  | | |___  | |___|  _ <| |___ / ___ \\| || |_| |  _ < "
  echo " |____/___| |_|     |_| |_| |_|_____|_|  |_|_____|  \\____|_| \\_\\_____/_/   \\_\\_| \\___/|_| \\_\\"
  echo "                                                                                             "
  echo "                                                                                 by: DefKorns "
  echo ""
  echo ""
  echo ""
  translate ASSET_APPLIED_SUCCESS
  echo ""
  echo ""
  translate SAVE_PREVIEW_HINT_LINE1
  translate SAVE_PREVIEW_HINT_LINE2
  echo ""
  echo ""
}

diyThemeChecker() {
  [ "$1" = "loader" ] && { "$om_scripts/gen_splash" /tmp/om_splash.png THEME_LOADING_ASSETS && decodepng /tmp/om_splash.png > /dev/fb0; }

  [ ! -d "$diy_theme_path" ] && mkdir -p "$diy_theme_path"

  if find "$diy_theme_path" -type f | read -r _; then
    enableCmds "diy" "del_diy" "preview"
  else
    disableCmds "diy" "del_diy" "preview"
  fi

  [ "$1" = "loader" ] && usleep 1000
}

diyThemeRemover() {
  disableCmds "diy" "del_diy" "preview"

  [ -d "$diy_theme_path" ] && find "$diy_theme_path" -type f -not -name 'assets_here' -exec rm {} +

}

modCleanUp() {
  for item in $items_to_delete; do
    remove "$item"
  done
  hasItemsToCleanUp "system_clean_up"
}

themeSettings() {
  if [ "$1" = "tpf" ] || [ "$1" = "mpf" ]; then
    flag="$om_themeperfolder"
    [ "$1" = "mpf" ] && flag="$om_musicperfolder"
    if [ ! -f "$flag" ]; then
      settingsOptionChecker "on" "$flag"
    else
      settingsOptionChecker "off" "$flag"
    fi
  else
    if [ ! -f "$om_themerandomizer" ]; then
      settingsOptionChecker "on" "$om_themerandomizer"
    else
      settingsOptionChecker "off" "$om_themerandomizer"
    fi
  fi
}

audioSettings() {
  if [ "$1" = "-amh" ]; then
    toggleOptions "$om_advmusichack" "$om_audiorandomizer"
  else
    if [ ! -f "$om_audiorandomizer" ]; then
      settingsOptionChecker "on" "$om_audiorandomizer"
    else
      settingsOptionChecker "off" "$om_audiorandomizer"
      settingsOptionChecker "off" "$om_advmusichack"
    fi
  fi
}

toggleOptions() {
  # $1=this flag file, $2=paired parent/child flag file, $3=set to skip the cascade
  if [ ! -f "$1" ]; then
    settingsOptionChecker "on" "$1"
    [ -z "$3" ] && [ ! -f "$2" ] && settingsOptionChecker "on" "$2"
  else
    remove "$1"
  fi
}

settingsOptionChecker() {
  if [ "$1" = "off" ]; then
    remove "$2"
  else
    touch "$2"
  fi
}

hasItemsToCleanUp() {
  for item in $items_to_delete; do
    if [ -e "$item" ]; then
      has_non_system_files="true"
      break
    fi
  done
  if [ "$has_non_system_files" = "true" ]; then
    enableCmds "$1"
    [ ! -f "$om_mod_settings_spacer" ] && touch "$om_mod_settings_spacer"
  else
    disableCmds "$1"
    [ ! -f "$enable_uninstaller" ] && remove "$om_mod_settings_spacer"
  fi
}

musicPerFolder() {
  [ -f "$om_musicperfolder" ] && hasMusicFiles "$music_path"
}

folderThemesRow() {
  if [ -f "$om_themeperfolder" ] && [ -d "$has_folders" ]; then
    enableCmds "folder_themes"
  else
    disableCmds "folder_themes"
  fi
  if hasMusicFiles "$music_path"; then
    enableCmds "music_per_folder"
  else
    disableCmds "music_per_folder"
  fi
  if musicPerFolder && [ -d "$has_folders" ]; then
    enableCmds "folder_music"
  else
    disableCmds "folder_music"
  fi
}

# a folder entry living in games/<P>/CLV-S-00<C>/ is folder <C> inside folder <P>
listFolders() {
  tab="$(printf '\t')"
  find "$game_storage" -maxdepth 3 -type f -name 'CLV-S-00*.desktop' -exec awk '
    /^Name=/ {
      name = substr($0, 6)
      if (name == "Back" || name == "Home") next
      n = split(FILENAME, path, "/")
      print path[n - 2] "\t" substr(path[n - 1], 9) "\t" name
    }' {} + | sort -f -t "$tab" -k3,3 | awk -F "$tab" '
    { kids[$1, ++count[$1]] = $2; names[$2] = $3 }
    function walk(parent, depth,    i, child, key) {
      for (i = 1; i <= count[parent]; i++) {
        child = kids[parent, i]
        if (child in seen) continue
        seen[child] = 1
        key = names[child]
        gsub(/ /, "_", key)
        print tolower(key) "\t" names[child] "\t" depth
        walk(child, depth + 1)
      }
    }
    END { walk("000", 0) }'
}

themeTitle() {
  title="$(sed -n 's/^NAME=//p' "$theme_path/$1/info" 2>/dev/null | sed 's/ \[[^]]*\]$//')"
  echo "${title:-$1}"
}

themePreview() {
  preview="$thm_preview/$1.png"
  [ ! -f "$preview" ] && preview="$theme_path/$1.png"
  [ ! -f "$preview" ] && preview="$options_menu/images/default_preview.png"
  echo "$preview"
}

globalTheme() {
  if [ -f "$om_themerandomizer" ]; then
    echo "@random"
  elif [ -f "$b_file" ]; then
    sed -n 's/^ *local selected_theme="\(.*\)"$/\1/p' "$b_file" | head -n1 | grep -v '^CHANGEME$'
  fi
}

folderThemesMenu() {
  data_dir="$folder_themes_tmp"
  rm -rf "$data_dir" && mkdir -p "$data_dir"
  {
    printf 'home\t%s\t0\n' "$(translate HOME_FOLDER)"
    listFolders
  } >"$data_dir/folders.list"
  find "$theme_path" -mindepth 1 -maxdepth 1 -type d | sed 's#^.*/##' | sort | while IFS= read -r thm; do
    has_music=0
    find "$theme_path/$thm" -type f -name "*.wav" | read -r _ && has_music=1
    needs_overlay=0
    [ -f "$theme_path/$thm/needs_overlay" ] && needs_overlay=1
    printf '%s\t%s\t%s\t%s\t%s\n' "$thm" "$(themeTitle "$thm")" "$(themePreview "$thm")" "$has_music" "$needs_overlay"
  done >"$data_dir/themes.list"
  find "$music_path" -maxdepth 1 -type f -iname "*.wav" 2>/dev/null | sed 's#^.*/##' | sort | while IFS= read -r wav; do
    printf '%s\t%s\n' "$wav" "$(echo "${wav%.*}" | sed 's/_/ /g')"
  done >"$data_dir/music.list"
  globalTheme >"$data_dir/global"
  {
    [ -f "$om_audiorandomizer" ] && echo random_home
    [ -f "$om_advmusichack" ] && echo random_folders
  } >"$data_dir/audio"
  echo "sh $om_mod_scripts/om_settings" >"$data_dir/om_return"

  title="FOLDER_THEMES"
  [ "$1" = "music" ] && title="FOLDER_MUSIC"
  set -- --commandPath "$data_dir/" --scriptPath "$data_dir" --title "$title" --folderThemes "$data_dir" --folderChannel "$1"
  [ -f "$om_themeperfolder" ] && set -- "$@" --mapping "$om_folderthemes"
  musicPerFolder && set -- "$@" --musicMapping "$om_foldermusic"
  $options_menu/lib/theme_manager "$@" &
}
