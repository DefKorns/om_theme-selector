# on/off state of a Settings toggle; reads the path om_settings cached
mod_state_path="$(cat /tmp/om_state_path 2> /dev/null)"
if [ -z "$mod_state_path" ]; then
  # shellcheck source=/dev/null
  source $mountpoint/etc/options_menu/scripts/om_functions
  script_init
fi

case "$1" in
  theme_per_folder) flag="$mod_state_path/om_themeperfolder" ;;
  music_per_folder) flag="$mod_state_path/om_musicperfolder" ;;
  theme_randomizer) flag="$mod_state_path/om_themerandomizer" ;;
  audio_randomizer) flag="$mod_state_path/om_audiorandomizer" ;;
  audio_randomizer_all) flag="$mod_state_path/om_advmusichack" ;;
esac

[ -f "$flag" ] && echo on || echo off
