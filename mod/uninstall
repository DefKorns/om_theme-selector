removeItem "$rootfs/bin/sprite_crop"
removeItem "$rootfs/bin/theme_downloader"
removeItem "$rootfs/etc/options_menu/lib/theme_manager"

[ -f "${font_path}/title.fnt.backup" ] && cp "${font_path}/title.fnt.backup" "${font_path}/title.fnt"
for font_name in s m l small medium large; do
  umount "${original_theme}/resources/fonts/${ui_subdir}/${font_name}.fnt" 2>/dev/null
  rm -f "${font_path}/${font_name}.fnt"
done

unset cfg_OM_ThemeSelector_enabled
