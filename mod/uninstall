removeItem() {
  for f in $@; do
    [ -f "$f" ] || [ -d "$f" ] && rm -rf "$f"
  done
}

font_path="$rootfs/usr/share/fonts"
ui_dir="ui/$sftype-$sfregion"
ui_subdir=""

case "$sftype" in
hvcj)
  ui_dir="ui/hvc"
  ;;
nes)
  ui_dir="clover-ui"
  ui_subdir="nes/"
  if [ "$sfregion" = "jpn" ]; then
    ui_dir="clover-ui"
    ui_subdir="hvc"
  fi
  ;;
snes)
  [ "$sfregion" = "jpn" ] && ui_dir="ui/shvc"
  ;;
esac

original_theme="$mountpoint/usr/share/$ui_dir"

sed -i '/# themeselector fix *$/,+2d' "$rootfs/bin/chmenu"
sed -i '/# themeselector$/,+4d' "$rootfs/etc/preinit.d/b8025_fontfix"
removeItem "$mountpoint/$profilepath/$modname/lastTheme"
removeItem "$mountpoint/$profilepath/$modname/prevTheme"
removeItem "$mountpoint/$profilepath/$modname/active_theme"
removeItem "$mountpoint/$profilepath/$modname/folder_themes"
removeItem "$mountpoint/$profilepath/$modname/folder_music"
removeItem "$mountpoint/$profilepath/$modname/om_advmusichack"
removeItem "$mountpoint/$profilepath/$modname/om_audiorandomizer"
removeItem "$mountpoint/$profilepath/$modname/om_themerandomizer"
removeItem "$mountpoint/$profilepath/$modname/om_firstrun"
removeItem "$rootfs/usr/share/themes"
removeItem "$rootfs/usr/share/music_menu"
chmod +x "$rootfs/bin/chmenu"
removeItem "$rootfs/etc/preinit.d/b8024_themeselector"
removeItem "$rootfs/etc/preinit.d/p8024_themeselector"
removeItem "$rootfs/etc/options_menu/commands/c0075_ThemeOptions"
removeItem "$rootfs/etc/options_menu/scripts/om_themeselector"
removeItem "$rootfs/etc/options_menu/scripts/om_theme_selector"
removeItem "$rootfs/etc/options_menu/themes"
removeItem "$rootfs/etc/options_menu/images/advanced.png"
removeItem "$rootfs/etc/options_menu/images/audio.png"
removeItem "$rootfs/etc/options_menu/images/audioall.png"
