removeItem "$rootfs/etc/options_menu/images/download.png"
removeItem "$rootfs/etc/options_menu/images/exit.png"
removeItem "$rootfs/etc/options_menu/images/loading"
removeItem "$rootfs/etc/options_menu/images/luigi.png"
removeItem "$rootfs/etc/options_menu/images/mario.png"
removeItem "$rootfs/etc/options_menu/images/packed.png"
removeItem "$rootfs/etc/options_menu/images/packed_nes.png"
removeItem "$rootfs/etc/options_menu/images/pole.png"
